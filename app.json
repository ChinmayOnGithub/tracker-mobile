{
  "expo": {
    "name": "Tracker",
    "slug": "tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "configureAndroidBackup": true }],
      "expo-sqlite"
    ],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.chinmaypatil.tracker" },
    "android": { "package": "com.chinmaypatil.tracker" },
    "web": { "bundler": "metro" }
  }
}